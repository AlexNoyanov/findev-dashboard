{
  "name": "findev-dashboard",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build:wasm": "node scripts/build-wasm.mjs",
    "start": "npm run build:wasm && ng serve",
    "build": "node scripts/build-app.mjs",
    "watch": "ng build --watch --configuration development",
    "test:unit": "ng test --watch=false",
    "test:wasm": "npm run build:wasm && node --test assembly/producer.test.mjs",
    "test": "npm run build:wasm && ng test --watch=false && node --test assembly/producer.test.mjs"
  },
  "private": true,
  "packageManager": "npm@10.9.2",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.28",
    "@angular/cli": "^21.2.28",
    "@angular/compiler-cli": "^21.2.0",
    "assemblyscript": "^0.28.20",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.1.12"
  }
}
